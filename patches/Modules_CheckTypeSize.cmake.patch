diff --git a/Modules/CheckTypeSize.cmake b/Modules/CheckTypeSize.cmake
index c0c9dbb3..be6c2ae8 100644
--- a/Modules/CheckTypeSize.cmake
+++ b/Modules/CheckTypeSize.cmake
@@ -307,6 +307,21 @@ function(__check_type_size_impl type var result_var map builtin language)
   endif()
 
+  # Add flag for z/OS compilers for ascii encoding of string literals.
+  if(CMAKE_SYSTEM_NAME MATCHES "OS390")
+    if(CMAKE_${language}_COMPILER_ID MATCHES "Clang")
+      # Change literal encoding only with -fexec-charset. Using -fzos-le-char-mode
+      # to set the Language Environment mode also affects ABI and is incompatible
+      # with the default -m32n ABI.
+      list(APPEND CMAKE_REQUIRED_DEFINITIONS "-fexec-charset=UTF-8")
+    elseif(CMAKE_${language}_COMPILER_ID MATCHES "zOS")
+      # Passing -qASCII to the legacy xlc compiler implicitly changes ABI
+      # select XPLINK; therefore the linker must use it too.
+      list(APPEND CMAKE_REQUIRED_DEFINITIONS "-qASCII")
+      list(APPEND CMAKE_REQUIRED_LINK_OPTIONS "-qASCII")
+    endif()
+  endif()
+
   # Include header files.
   set(headers)
   if(NOT builtin)
     if(language STREQUAL "CXX" AND type MATCHES "^std::")
