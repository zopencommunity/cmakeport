index 9723fb6b..2a815eb9 100644
--- a/Modules/CMakeDetermineCCompiler.cmake
+++ b/Modules/CMakeDetermineCCompiler.cmake
@@ -76,6 +76,11 @@ else()
     # Try compiling to an object file only.
     "-c"
 
+    "-fzos-le-char-mode=ascii"
+    "-m32 -fzos-le-char-mode=ascii"
+    "-m64 -fzos-le-char-mode=ascii"
+    "-qascii"
+
     # Try enabling ANSI mode on HP.
     "-Aa"
 
@@ -92,7 +97,13 @@ else()
     )
 endif()
 if(CMAKE_C_COMPILER_TARGET)
-  set(CMAKE_C_COMPILER_ID_TEST_FLAGS_FIRST "-c --target=${CMAKE_C_COMPILER_TARGET}")
+  if(CMAKE_SYSTEM_NAME MATCHES "OS390")
+    # z/OS object files sometimes don't have continuous string literals, therefore
