--- a/Modules/CMakeDetermineCompilerABI.cmake
+++ b/Modules/CMakeDetermineCompilerABI.cmake
@@ -71,6 +71,18 @@ function(CMAKE_DETERMINE_COMPILER_ABI lang src)
     if(DEFINED CMAKE_${lang}_VERBOSE_LINK_FLAG)
       list(APPEND LINK_OPTIONS "${CMAKE_${lang}_VERBOSE_LINK_FLAG}")
     endif()
+    # Add flag for z/OS compilers for ascii encoding of string literals.
+    if(CMAKE_SYSTEM_NAME MATCHES "OS390")
+      if(CMAKE_${lang}_COMPILER_ID MATCHES "Clang")
+        # Change literal encoding only with -fexec-charset. Using -fzos-le-char-mode
+        # to set the Language Environment mode also affects ABI and is incompatible
+        # with the default -m32n ABI.
+        list(APPEND COMPILE_DEFINITIONS "-fexec-charset=UTF-8")
+      elseif(CMAKE_${lang}_COMPILER_ID MATCHES "zOS")
+        list(APPEND COMPILE_DEFINITIONS "-qascii")
+        list(APPEND LINK_OPTIONS "-qascii")
+      endif()
+    endif()
     if(lang MATCHES "^(CUDA|HIP)$")
       if(CMAKE_CUDA_ARCHITECTURES STREQUAL "native")
